{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "alice_own_read",
      "label_es": "Alice lee su informe",
      "steps": [
        {
          "method": "GET",
          "path": "/reports/101",
          "token": "lab-alice-only",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "id": "101",
                "owner": "alice",
                "title": "Informe sintético A",
                "marker": "SYNTHETIC_ALICE_101"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "id": "101",
                "owner": "alice",
                "title": "Informe sintético A",
                "marker": "SYNTHETIC_ALICE_101"
              }
            }
          }
        }
      ]
    },
    {
      "id": "bruno_own_read",
      "label_es": "Bruno lee su informe",
      "steps": [
        {
          "method": "GET",
          "path": "/reports/202",
          "token": "lab-bruno-only",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "id": "202",
                "owner": "bruno",
                "title": "Informe sintético B",
                "marker": "SYNTHETIC_BRUNO_202"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "id": "202",
                "owner": "bruno",
                "title": "Informe sintético B",
                "marker": "SYNTHETIC_BRUNO_202"
              }
            }
          }
        }
      ]
    },
    {
      "id": "alice_cross_read",
      "label_es": "Alice intenta leer el informe de Bruno",
