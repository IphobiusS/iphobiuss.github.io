{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "alice_logout",
      "label_es": "Alice: cerrar sesión invalida solo el token actual",
      "steps": [
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            }
          },
          "token": "lab-alice-laptop"
        },
        {
          "method": "POST",
          "path": "/logout",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "signed_out": true
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "signed_out": true
              }
            }
          },
          "token": "lab-alice-laptop",
          "body": "{}"
        },
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            },
            "fixed": {
              "status": 401,
              "body": {
                "error": "unauthorized"
              }
            }
          },
          "token": "lab-alice-laptop"
        },
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            }
          },
          "token": "lab-alice-phone"
        },
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "bruno",
                "marker": "SYNTHETIC_BRUNO"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "identity": "bruno",
                "marker": "SYNTHETIC_BRUNO"
              }
            }
          },
          "token": "lab-bruno-laptop"
        }
      ]
    },
    {
      "id": "alice_password",
      "label_es": "Alice: cambiar la contraseña invalida sus dos dispositivos",
      "steps": [
        {
          "method": "POST",
          "path": "/password",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "changed": true,
                "scope": "all_sessions_of_current_identity"
