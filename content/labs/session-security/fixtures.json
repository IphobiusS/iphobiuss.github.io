              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "token": "lab-alice-issued-1",
                "session_id": "alice-new-1",
                "ttl_seconds": 60
              }
            }
          },
          "body": "{\"user\":\"alice\",\"password\":\"demo-alice-changed\"}"
        },
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            },
            "fixed": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            }
          },
          "token": "lab-alice-issued-1"
        }
