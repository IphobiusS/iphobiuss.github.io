          "token": "lab-alice-laptop",
          "body": "{\"current_password\":\"demo-alice-initial\",\"new_password\":\"demo-alice-changed\"}"
        },
        {
          "method": "GET",
          "path": "/me",
          "expected": {
            "vulnerable": {
              "status": 200,
              "body": {
                "identity": "alice",
                "marker": "SYNTHETIC_ALICE"
              }
            },
            "fixed": {
              "status": 401,
              "body": {
                "error": "unauthorized"
              }
            }
          },
          "token": "lab-alice-laptop"
        },
        {
          "method": "GET",
          "path": "/me",
